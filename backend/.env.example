# ============================================================
# TrustPULSE Backend Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Server port
PORT=5000

# MongoDB connection string
# For local development: mongodb://localhost:27017/trustpulse
# For Docker: mongodb://mongodb:27017/trustpulse
MONGO_URI=mongodb://mongodb:27017/trustpulse

# Node environment: development | production
NODE_ENV=development

# Cache duration in hours (default: 24)
CACHE_DURATION_HOURS=24

# Google API Key (Optional: For real scraping in the future)
GOOGLE_API_KEY=your_google_api_key_here

